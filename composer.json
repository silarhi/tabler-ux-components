{
    "name": "silarhi/tabler-ux-components",
    "description": "Tabler-flavored Twig UX components for Symfony, following the shadcn composition pattern.",
    "license": "MIT",
    "type": "symfony-bundle",
    "keywords": [
        "symfony",
        "symfony-ux",
        "twig",
        "twig-component",
        "tabler",
        "bootstrap",
        "shadcn",
        "ui"
    ],
    "authors": [
        {
            "name": "Guillaume Sainthillier",
            "email": "guillaume@silarhi.fr"
        }
    ],
    "require": {
        "php": ">=8.2",
        "symfony/framework-bundle": "^6.4 || ^7.0 || ^8.0",
        "symfony/twig-bundle": "^6.4 || ^7.0 || ^8.0",
        "symfony/ux-twig-component": "^2.21 || ^3.0",
        "twig/extra-bundle": "^3.12 || ^4.0",
        "twig/html-extra": "^3.12 || ^4.0",
        "twig/twig": "^3.12 || ^4.0"
    },
    "require-dev": {
        "ergebnis/composer-normalize": "^2.52",
        "friendsofphp/php-cs-fixer": "^3.95.3",
        "phpstan/extension-installer": "^1.4.3",
        "phpstan/phpstan": "^2.2.1",
        "phpstan/phpstan-strict-rules": "^2.0.11",
        "phpstan/phpstan-symfony": "^2.0.19",
        "phpunit/phpunit": "^11.5.55 || ^12 || ^13.1.13",
        "rector/rector": "^2.4.5",
        "vincentlanglet/twig-cs-fixer": "^3.14"
    },
    "autoload": {
        "psr-4": {
            "Silarhi\\TablerUxComponents\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Silarhi\\TablerUxComponents\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true,
            "phpstan/extension-installer": true
        },
        "bump-after-update": "dev",
        "preferred-install": {
            "*": "dist"
        },
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "test:coverage": "phpunit"
    }
}
