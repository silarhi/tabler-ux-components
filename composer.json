{
    "name": "silarhi/tabler-ux-components",
    "description": "Tabler-flavored Twig UX components for Symfony, following the shadcn composition pattern.",
    "license": "MIT",
    "type": "symfony-bundle",
    "keywords": [
        "symfony",
        "symfony-ux",
        "twig",
        "twig-component",
        "tabler",
        "bootstrap",
        "shadcn",
        "ui"
    ],
    "authors": [
        {
            "name": "Guillaume Sainthillier",
            "email": "guillaume@silarhi.fr"
        }
    ],
    "homepage": "https://tabler-ux-components.silarhi.dev",
    "support": {
        "issues": "https://github.com/silarhi/tabler-ux-components/issues",
        "source": "https://github.com/silarhi/tabler-ux-components",
        "docs": "https://tabler-ux-components.silarhi.dev"
    },
    "require": {
        "php": ">=8.2",
        "symfony/service-contracts": "^2.5 || ^3.0",
        "symfony/ux-twig-component": "^2.21 || ^3.0",
        "twig/html-extra": "^3.12 || ^4.0",
        "twig/twig": "^3.15 || ^4.0"
    },
    "require-dev": {
        "ext-dom": "*",
        "ext-libxml": "*",
        "ergebnis/composer-normalize": "^2.58.0",
        "friendsofphp/php-cs-fixer": "^3.95.32",
        "phpstan/extension-installer": "^1.4.3",
        "phpstan/phpstan": "^2.3.7",
        "phpstan/phpstan-strict-rules": "^2.1.2",
        "phpstan/phpstan-symfony": "^2.1.1",
        "phpunit/phpunit": "^11.5.58 || ^12.5.38 || ^13.4.1",
        "psr/container": "^1.1 || ^2.0",
        "rector/rector": "^2.9.2",
        "symfony/config": "^6.4 || ^7.0 || ^8.0",
        "symfony/dependency-injection": "^6.4 || ^7.0 || ^8.0",
        "symfony/error-handler": "^6.4 || ^7.0 || ^8.0",
        "symfony/event-dispatcher": "^6.4 || ^7.0 || ^8.0",
        "symfony/form": "^6.4 || ^7.0 || ^8.0",
        "symfony/framework-bundle": "^6.4 || ^7.0 || ^8.0",
        "symfony/http-kernel": "^6.4 || ^7.0 || ^8.0",
        "symfony/property-access": "^6.4 || ^7.0 || ^8.0",
        "symfony/routing": "^6.4 || ^7.0 || ^8.0",
        "symfony/twig-bundle": "^6.4 || ^7.0 || ^8.0",
        "symfony/ux-icons": "^2.36.1 || ^3.0",
        "twig/extra-bundle": "^3.12 || ^4.0",
        "vincentlanglet/twig-cs-fixer": "^4.1.2"
    },
    "conflict": {
        "symfony/config": "<6.4",
        "symfony/dependency-injection": "<6.4",
        "symfony/http-kernel": "<6.4"
    },
    "suggest": {
        "symfony/form": "To use the Tabler form themes and their options (icon, stepper, choice_style, switch)",
        "symfony/framework-bundle": "Register Silarhi\\TablerUxComponents\\TablerUxComponentsBundle, with symfony/twig-bundle, for zero-config wiring (optional: from symfony/ux-twig-component 3.2, a plain Twig environment renders the components without symfony/dependency-injection nor symfony/http-kernel, see the README)",
        "symfony/ux-icons": "To render any icon of Iconify or your own SVG files with the Icon component and the icon props (names with an icon set prefix, e.g. \"lucide:check\")"
    },
    "autoload": {
        "psr-4": {
            "Silarhi\\TablerUxComponents\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Silarhi\\TablerUxComponents\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true,
            "phpstan/extension-installer": true
        },
        "audit": {
            "block-insecure": false
        },
        "bump-after-update": "dev",
        "preferred-install": {
            "*": "dist"
        },
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "test:coverage": "phpunit"
    }
}
