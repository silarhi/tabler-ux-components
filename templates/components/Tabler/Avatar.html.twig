{#
    Tabler Avatar — image, initials, or icon.

    All-in-one:
        <twig:Tabler:Avatar image="/avatars/jane.jpg" />
        <twig:Tabler:Avatar variant="primary" size="lg">JL</twig:Tabler:Avatar>
        <twig:Tabler:Avatar rounded><i class="ti ti-user"></i></twig:Tabler:Avatar>

    Group avatars with <twig:Tabler:Avatar:List stacked>; add a corner mark with
    <twig:Tabler:Avatar:Brand>; an empty slot is <twig:Tabler:Avatar:Upload>.

    Props:
      size     — xxs | xs | sm | md (default) | lg | xl | 2xl
      variant    — tinted background for initials (bg-{variant}-lt)
      rounded  — circular avatar (rounded-circle)
      square   — rounded corners instead of a circle (avatar-square, Tabler 1.5+)
      cover    — pull the avatar over the element above it, with a ring, e.g. over a Card:Cover (avatar-cover)
      image    — background image URL
#}
{% apply trim %}
{% props
    ## 'xxs'|'xs'|'sm'|'md'|'lg'|'xl'|'2xl' The avatar size (`avatar-{size}`).
    size = 'md',
    ## 'primary'|'secondary'|'success'|'danger'|'warning'|'info'|'dark'|'light'|null The tinted background, for initials (`bg-{variant}-lt`).
    variant = null,
    ## bool Whether to make the avatar a circle (`rounded-circle`).
    rounded = false,
    ## bool Whether to use rounded corners instead of a circle (`avatar-square`).
    square = false,
    ## bool Whether to pull the avatar over the element above it, with a ring (`avatar-cover`).
    cover = false,
    ## string|null The image URL, set as an inline `background-image` style.
    image = null,
%}

{% set avatar = html_cva(
    base: 'avatar',
    variants: {
        size: {xxs: 'avatar-xxs', xs: 'avatar-xs', sm: 'avatar-sm', md: '', lg: 'avatar-lg', xl: 'avatar-xl', '2xl': 'avatar-2xl'},
        variant: {
            primary: 'bg-primary-lt',
            secondary: 'bg-secondary-lt',
            success: 'bg-success-lt',
            danger: 'bg-danger-lt',
            warning: 'bg-warning-lt',
            info: 'bg-info-lt',
            dark: 'bg-dark-lt',
            light: 'bg-light-lt',
        },
        rounded: {true: 'rounded-circle', false: ''},
        square: {true: 'avatar-square', false: ''},
        cover: {true: 'avatar-cover', false: ''},
    },
) %}

{# the background image goes first so a user `style` can still override it #}
{% set style = [image is not null ? 'background-image: url(' ~ image ~ ')' : null, attributes.render('style')]|filter(v => v is not empty)|join('; ') %}

<span class="{{ avatar.apply({size: size, variant: variant ?? '', rounded: rounded, square: square, cover: cover}, attributes.render('class')) }}"{% if style %} style="{{ style }}"{% endif %} {{ attributes.without('class', 'style') }}>{## The avatar content: initials or an icon. #}{%- block content %}{% endblock -%}</span>
{% endapply ~%}
