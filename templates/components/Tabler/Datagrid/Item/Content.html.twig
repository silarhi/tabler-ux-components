{#
    Datagrid item content — the value of a datagrid item.

    Usage:
        <twig:Tabler:Datagrid:Item:Content>Third Party</twig:Tabler:Datagrid:Item:Content>
#}
{% apply trim %}
<div {{ attributes.defaults({class: 'datagrid-content'}) }}>{## The value. #}{%- block content %}{% endblock -%}</div>
{% endapply ~%}
