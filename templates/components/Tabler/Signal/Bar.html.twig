{#
    Signal bar — one bar of a <twig:Tabler:Signal> (`.signal-bar`).

    Usage:
        <twig:Tabler:Signal:Bar active />

    Props:
      active  — lights the bar
#}
{% apply trim %}
{% props
    ## bool Whether to light the bar (`active`).
    active = false,
%}

<span class="signal-bar{{ active ? ' active' : '' }}{{ attributes.render('class') ? ' ' ~ attributes.render('class') : '' }}" {{ attributes.without('class') }}></span>
{% endapply ~%}
