{#
    Tag status — a small colored dot at the start of a tag (`.badge-dot`).
    Decorative: the tag text has to say what the status is.

    Usage:
        <twig:Tabler:Tag:Status variant="success" />

    Props:
      variant  — primary | secondary | success | danger | warning | info | dark | light | muted,
                 or a palette color: blue | azure | indigo | purple | pink | red | orange | yellow | lime | green | teal | cyan
#}
{% apply trim %}
{% props
    ## 'primary'|'secondary'|'success'|'danger'|'warning'|'info'|'dark'|'light'|'muted'|'blue'|'azure'|'indigo'|'purple'|'pink'|'red'|'orange'|'yellow'|'lime'|'green'|'teal'|'cyan'|null The dot color.
    variant = null,
%}

{% set dot = html_cva(
    base: 'badge badge-dot',
    variants: {
        variant: {
            primary: 'bg-primary',
            secondary: 'bg-secondary',
            success: 'bg-success',
            danger: 'bg-danger',
            warning: 'bg-warning',
            info: 'bg-info',
            dark: 'bg-dark',
            light: 'bg-light',
            muted: 'bg-muted',
            blue: 'bg-blue',
            azure: 'bg-azure',
            indigo: 'bg-indigo',
            purple: 'bg-purple',
            pink: 'bg-pink',
            red: 'bg-red',
            orange: 'bg-orange',
            yellow: 'bg-yellow',
            lime: 'bg-lime',
            green: 'bg-green',
            teal: 'bg-teal',
            cyan: 'bg-cyan',
        },
    },
) %}

<span class="{{ dot.apply({variant: variant ?? ''}, attributes.render('class')) }}" {{ attributes.defaults({'aria-hidden': 'true'}).without('class') }}></span>
{% endapply ~%}
