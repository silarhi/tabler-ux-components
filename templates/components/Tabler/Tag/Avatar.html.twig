{#
    Tag avatar — a small avatar at the start of a tag (`.tag-avatar`).

    Usage:
        <twig:Tabler:Tag:Avatar image="/avatars/alex.jpg" />
        <twig:Tabler:Tag:Avatar>AP</twig:Tabler:Tag:Avatar>

    Props:
      image  — background image URL
#}
{% apply trim %}
{% props
    image = null,
%}

{# the background image goes first so a user `style` can still override it #}
{% set style = [image is not null ? 'background-image: url(' ~ image ~ ')' : null, attributes.render('style')]|filter(v => v is not empty)|join('; ') %}

<span class="{{ ('avatar avatar-xs tag-avatar ' ~ attributes.render('class'))|trim }}"{% if style %} style="{{ style }}"{% endif %} {{ attributes.without('class', 'style') }}>
    {%- block content %}{% endblock -%}
</span>
{% endapply %}
