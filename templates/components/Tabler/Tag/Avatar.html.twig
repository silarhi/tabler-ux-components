{#
    Tag avatar — a small avatar at the start of a tag (`.tag-avatar`).

    Usage:
        <twig:Tabler:Tag:Avatar image="/avatars/alex.jpg" />
        <twig:Tabler:Tag:Avatar>AP</twig:Tabler:Tag:Avatar>

    Props:
      image  — background image URL
#}
{% props
    image = null,
%}

<span class="{{ ('avatar avatar-xs tag-avatar ' ~ attributes.render('class'))|trim }}"{% if image is not null %} style="background-image: url({{ image }})"{% endif %} {{ attributes.without('class', 'style') }}>
    {%- block content %}{% endblock -%}
</span>
