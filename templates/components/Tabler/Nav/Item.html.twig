{#
    Nav item — one link in a <twig:Tabler:Nav>.

    Usage:
        <twig:Tabler:Nav:Item href="/" active>Active</twig:Tabler:Nav:Item>
        <twig:Tabler:Nav:Item disabled>Disabled</twig:Tabler:Nav:Item>

    Props:
      href      — link target; when omitted renders a non-link <a>
      active    — marks the current item
      disabled  — non-interactive item
#}
{% apply trim %}
{% props
    ## string|null The link target; without it, renders an `<a>` with no `href`.
    href = null,
    ## bool Whether the item is the current one (`active`, `aria-current`).
    active = false,
    ## bool Whether the item is non-interactive (`disabled`).
    disabled = false,
%}

{% set link = html_cva(
    base: 'nav-link',
    variants: {
        active: {true: 'active', false: ''},
        disabled: {true: 'disabled', false: ''},
    },
) %}

<li class="nav-item">
    <a class="{{ link.apply({active: active, disabled: disabled}, attributes.render('class')) }}"{% if href is not null %} href="{{ href }}"{% endif %}{% if active %} aria-current="page"{% endif %}{% if disabled %} aria-disabled="true"{% endif %} {{ attributes.without('class', 'href') }}>{## The link text. #}{%- block content %}{% endblock -%}</a>
</li>
{% endapply ~%}
