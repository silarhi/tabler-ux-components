{#
    Tabler StarRating — a read-only row of stars showing a score (`.stars`).

    The row gets role="img" and an "N out of M" `aria-label` (pass your own
    `aria-label` to override it). Keep the score visible in text next to it too.
    Composed stars ignore `value` and `max`, so a composed rating gets no default
    label: pass an `aria-label` (it then gets role="img").
    The interactive star rating relies on a third-party library and is not
    covered.

    All-in-one:
        <twig:Tabler:StarRating value="4" />
        <twig:Tabler:StarRating value="3" max="10" variant="red" icon="heart" aria-label="3 of 10 hearts" />
        <twig:Tabler:StarRating value="4" filled />

    Composed:
        <twig:Tabler:StarRating aria-label="2 out of 3">
            <twig:Tabler:StarRating:Star active />
            <twig:Tabler:StarRating:Star active />
            <twig:Tabler:StarRating:Star />
        </twig:Tabler:StarRating>

    Props:
      value    — number of active stars (default 0)
      max      — total number of stars (default 5)
      variant  — color of the active stars (default yellow): primary | secondary | success | danger | warning | info | dark | light | muted,
                 or a palette color: blue | azure | indigo | purple | pink | red | orange | yellow | lime | green | teal | cyan
      icon     — Tabler icon name of each star (default star)
      filled   — filled icons (see <twig:Tabler:Icon filled>, which needs the filled webfont)
#}
{% apply trim %}
{% props
    value = 0,
    max = 5,
    variant = 'yellow',
    icon = 'star',
    filled = false,
%}

{%- set default_stars -%}
    {#- 1..0 counts down to [1, 0], so a zero `max` must skip the loop -#}
    {%- if max > 0 -%}
        {%- for i in 1..max -%}
            <twig:Tabler:StarRating:Star active="{{ i <= value }}" variant="{{ variant }}" icon="{{ icon }}" filled="{{ filled }}" />
        {%- endfor -%}
    {%- endif -%}
{%- endset -%}
{%- set stars -%}{%- block content -%}{{ default_stars }}{%- endblock -%}{%- endset -%}
{#- Composed stars ignore `value` and `max`: an "N out of M" label built from them would be wrong, so a composed
    rating only gets role="img" when it has its own aria-label -#}
{% set composed = stars != default_stars %}
{% set labelled = 'aria-label' in attributes.all|keys %}

<div {{ attributes.defaults({class: 'stars'}|merge(labelled or not composed ? {role: 'img'} : {})|merge(composed ? {} : {'aria-label': value ~ ' out of ' ~ max})) }}>{{ stars }}</div>
{% endapply ~%}
