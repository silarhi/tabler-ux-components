{#
    Tabler Tabs — the tab bar (nav). Pair with <twig:Tabler:Tabs:Content>.

    Composed:
        <twig:Tabler:Tabs>
            <twig:Tabler:Tabs:Item target="home" active>Home</twig:Tabler:Tabs:Item>
            <twig:Tabler:Tabs:Item target="profile">Profile</twig:Tabler:Tabs:Item>
        </twig:Tabler:Tabs>
        <twig:Tabler:Tabs:Content>
            <twig:Tabler:Tabs:Pane id="home" active>Home content</twig:Tabler:Tabs:Pane>
            <twig:Tabler:Tabs:Pane id="profile">Profile content</twig:Tabler:Tabs:Pane>
        </twig:Tabler:Tabs:Content>

    Props:
      pills      — pill style (nav-pills) instead of tabs
      underline  — underline style (nav-underline) instead of tabs
      bordered   — bottom border under the whole bar (nav-bordered)
      fill       — tabs share the full width (nav-fill)
      card       — card-header tab style (card-header-tabs)
#}
{% props
    pills = false,
    underline = false,
    bordered = false,
    fill = false,
    card = false,
%}

{% set tabs = html_cva(
    base: 'nav',
    variants: {
        look: {tabs: 'nav-tabs', pills: 'nav-pills', underline: 'nav-underline'},
        bordered: {true: 'nav-bordered', false: ''},
        fill: {true: 'nav-fill', false: ''},
        card: {true: 'card-header-tabs', false: ''},
    },
) %}

<ul class="{{ tabs.apply({look: pills ? 'pills' : (underline ? 'underline' : 'tabs'), bordered: bordered, fill: fill, card: card}, attributes.render('class')) }}" data-bs-toggle="tabs" role="tablist" {{ attributes.without('class') }}>
    {% block content %}{% endblock %}
</ul>
