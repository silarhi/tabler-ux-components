{#
    Tabler Pagination — page navigation.

    Composed:
        <twig:Tabler:Pagination>
            <twig:Tabler:Pagination:Item href="?page=1" disabled>«</twig:Tabler:Pagination:Item>
            <twig:Tabler:Pagination:Item href="?page=1">1</twig:Tabler:Pagination:Item>
            <twig:Tabler:Pagination:Item href="?page=2" active>2</twig:Tabler:Pagination:Item>
            <twig:Tabler:Pagination:Item href="?page=3">3</twig:Tabler:Pagination:Item>
        </twig:Tabler:Pagination>

    Props:
      outline  — outline style (pagination-outline)
      circle   — circular page links (pagination-circle)
      size     — sm | md (default) | lg
#}
{% apply trim %}
{% props
    ## bool Whether to use the outline style (`pagination-outline`).
    outline = false,
    ## bool Whether to make the page links circular (`pagination-circle`).
    circle = false,
    ## 'sm'|'md'|'lg' The pagination size.
    size = 'md',
%}

{% set pagination = html_cva(
    base: 'pagination',
    variants: {
        outline: {true: 'pagination-outline', false: ''},
        circle: {true: 'pagination-circle', false: ''},
        size: {sm: 'pagination-sm', md: '', lg: 'pagination-lg'},
    },
) %}

<ul class="{{ pagination.apply({outline: outline, circle: circle, size: size}, attributes.render('class')) }}" {{ attributes.without('class') }}>
    {## The page links: `Pagination:Item` components. -#}
    {% block content %}{% endblock %}
</ul>
{% endapply ~%}
