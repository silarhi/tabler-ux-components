{#
    Timeline event title — the heading of a timeline event.

    Usage:
        <twig:Tabler:Timeline:Event:Title>Database backup completed</twig:Tabler:Timeline:Event:Title>
#}
{% apply trim %}
<h4 {{ attributes }}>{## The event heading. #}{%- block content %}{% endblock -%}</h4>
{% endapply ~%}
