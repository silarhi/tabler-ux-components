{#
    Tabler Legend — a colored marker, a label and an optional value, naming the
    series of a chart or a progress bar (Tabler 1.6+).

    Renders a <span> by default, an <a> when `href` is set, or a
    <button type="button"> when `button` is set (e.g. to toggle a chart series).

    All-in-one (use the `label` prop so the dot, label and value all stay inside `content`):
        <twig:Tabler:Legend variant="blue" label="Allowed" value="339.0k" />
        <twig:Tabler:Legend variant="primary" size="lg" label="P99" value="124" unit="ms" />

    In a list:
        <twig:Tabler:Legend:List divided>
            <twig:Tabler:Legend variant="green" label="Passed" value="128" href="?status=passed" active />
            <twig:Tabler:Legend variant="red" label="Failed" value="4" href="?status=failed" />
        </twig:Tabler:Legend:List>

    Composed (override `content`, or just the `dot` / `label` / `value` sub-blocks):
        <twig:Tabler:Legend variant="blue" button>
            <twig:Tabler:Legend:Dot />
            Allowed
            <twig:Tabler:Legend:Value unit="k">339</twig:Tabler:Legend:Value>
        </twig:Tabler:Legend>

    Props:
      variant  — primary | secondary | success | danger | warning | info | dark | light | muted,
                 or a palette color: blue | azure | indigo | purple | pink | red | orange | yellow | lime | green | teal | cyan
      size     — md (default) | lg (label on top, big value below)
      label    — the series name; mirrored by the `label` block
      value    — optional value; mirrored by the `value` block
      unit     — optional unit after the value (legend-unit)
      href     — when set, renders <a href>
      button   — renders a <button type="button">
      active   — keeps the hover background (active)
      off      — dims the item, for a hidden series (legend-off)
#}
{% apply trim %}
{% props
    ## 'primary'|'secondary'|'success'|'danger'|'warning'|'info'|'dark'|'light'|'muted'|'blue'|'azure'|'indigo'|'purple'|'pink'|'red'|'orange'|'yellow'|'lime'|'green'|'teal'|'cyan'|null The color of the dot.
    variant = null,
    ## 'md'|'lg' The size; `lg` puts the label on top and a big value below (`legend-lg`).
    size = 'md',
    ## string|null The series name.
    label = null,
    ## string|null The value, rendered with `Legend:Value`.
    value = null,
    ## string|null The unit after the value, rendered with `Legend:Unit`.
    unit = null,
    ## string|null The link target; renders an `<a href>` instead of a `<span>`.
    href = null,
    ## bool Whether to render a `<button type="button">` instead of a `<span>` (ignored with `href`).
    button = false,
    ## bool Whether to keep the hover background (`active`).
    active = false,
    ## bool Whether to dim the item, for a hidden series (`legend-off`).
    off = false,
%}

{% set legend = html_cva(
    base: 'legend',
    variants: {
        size: {md: '', lg: 'legend-lg'},
        variant: {
            primary: 'legend-primary',
            secondary: 'legend-secondary',
            success: 'legend-success',
            danger: 'legend-danger',
            warning: 'legend-warning',
            info: 'legend-info',
            dark: 'legend-dark',
            light: 'legend-light',
            muted: 'legend-muted',
            blue: 'legend-blue',
            azure: 'legend-azure',
            indigo: 'legend-indigo',
            purple: 'legend-purple',
            pink: 'legend-pink',
            red: 'legend-red',
            orange: 'legend-orange',
            yellow: 'legend-yellow',
            lime: 'legend-lime',
            green: 'legend-green',
            teal: 'legend-teal',
            cyan: 'legend-cyan',
        },
        active: {true: 'active', false: ''},
        off: {true: 'legend-off', false: ''},
    },
) %}

{% set classes = legend.apply({size: size, variant: variant ?? '', active: active, off: off}, attributes.render('class')) %}
{% set tag = href is not null ? 'a' : (button ? 'button' : 'span') %}
<{{ tag }}{% if href is not null %} href="{{ href }}"{% elseif button %} type="button"{% endif %} class="{{ classes }}" {{ attributes.without('class', 'href', 'type') }}>{## The legend content: `dot`, `label` and `value`; replace it to compose freely. -#}
    {%- block content -%}
        {## The colored marker: `Legend:Dot`. -#}
        {%- block dot -%}<twig:Tabler:Legend:Dot />{%- endblock %}
        {## The series name: the `label` prop, when set. -#}
        {% block label -%}{%- if label is not null -%}{{ label }}{%- endif -%}{%- endblock %}
        {## The value: `Legend:Value` with the `value` and `unit` props, when `value` is set. -#}
        {% block value -%}
            {%- if value is not null -%}<twig:Tabler:Legend:Value unit="{{ unit }}">{{ value }}</twig:Tabler:Legend:Value>{%- endif -%}
        {%- endblock -%}
    {%- endblock -%}
</{{ tag }}>
{% endapply ~%}
