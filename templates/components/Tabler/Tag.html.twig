{#
    Tabler Tag — a compact inline label with optional leading media, a counter
    badge and a remove button (`.tag`).

    All-in-one:
        <twig:Tabler:Tag label="Featured" icon="star" dismissible />
        <twig:Tabler:Tag label="Alex P." avatar="/avatars/alex.jpg" dismissible />
        <twig:Tabler:Tag label="Online" status="success" />
        <twig:Tabler:Tag label="Notifications" badge="12" />
        <twig:Tabler:Tag label="Selected" checkbox checked />

    In a list:
        <twig:Tabler:Tag:List>
            <twig:Tabler:Tag label="Alpha" dismissible />
            <twig:Tabler:Tag label="Beta" dismissible />
        </twig:Tabler:Tag:List>

    Composed (override `content`, or just the `leading` / `label` / `badge` / `close` blocks):
        <twig:Tabler:Tag>
            <twig:Tabler:Tag:Avatar>AP</twig:Tabler:Tag:Avatar>
            Alex P.
            <twig:Tabler:Tag:Close aria-label="Remove Alex" />
        </twig:Tabler:Tag>

    Props:
      label        — the tag text; mirrored by the `label` block
      icon         — leading Tabler icon name (tag-icon)
      avatar       — leading avatar image URL (Tag:Avatar)
      status       — leading status dot color: primary | secondary | success | danger | warning | info | dark | light | muted,
                     or a palette color (Tag:Status)
      checkbox     — leading checkbox, for a selectable filter (Tag:Check)
      checked      — initial state of that checkbox
      badge        — optional counter; mirrored by the `badge` block
      dismissible  — show a remove button labelled "Remove <label>"; mirrored by the `close` block
#}
{% props
    label = null,
    icon = null,
    avatar = null,
    status = null,
    checkbox = false,
    checked = false,
    badge = null,
    dismissible = false,
%}

<span {{ attributes.defaults({class: 'tag'}) }}>
    {%- block content -%}
        {%- block leading -%}
            {%- if checkbox -%}{%- if label is not null -%}<twig:Tabler:Tag:Check checked="{{ checked }}" aria-label="{{ label }}" />{%- else -%}<twig:Tabler:Tag:Check checked="{{ checked }}" />{%- endif -%}{%- endif -%}
            {%- if avatar is not null -%}<twig:Tabler:Tag:Avatar image="{{ avatar }}" />{%- endif -%}
            {%- if icon is not null -%}<twig:Tabler:Icon name="{{ icon }}" class="tag-icon" aria-hidden="true" />{%- endif -%}
            {%- if status is not null -%}<twig:Tabler:Tag:Status variant="{{ status }}" />{%- endif -%}
        {%- endblock -%}
        {%- block label -%}{{ label }}{%- endblock -%}
        {%- block badge -%}
            {%- if badge is not null -%}<twig:Tabler:Tag:Badge>{{ badge }}</twig:Tabler:Tag:Badge>{%- endif -%}
        {%- endblock -%}
        {%- block close -%}
            {%- if dismissible -%}<twig:Tabler:Tag:Close aria-label="{{ label is not null ? 'Remove ' ~ label : 'Remove' }}" />{%- endif -%}
        {%- endblock -%}
    {%- endblock -%}
</span>
