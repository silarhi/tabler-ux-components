{#
    Offcanvas body — the content area of an offcanvas panel.

    Usage:
        <twig:Tabler:Offcanvas:Body>…</twig:Tabler:Offcanvas:Body>
#}
{% apply trim %}
<div {{ attributes.defaults({class: 'offcanvas-body'}) }}>{## The body content. #}{%- block content %}{% endblock -%}</div>
{% endapply ~%}
