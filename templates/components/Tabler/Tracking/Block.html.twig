{#
    Tracking block — a single segment in a <twig:Tabler:Tracking>.

    Usage:
        <twig:Tabler:Tracking:Block variant="success" />
        <twig:Tabler:Tracking:Block variant="danger" tooltip="Downtime" />

    Props:
      variant    — primary | secondary | success | danger | warning | info | dark | light
      tooltip  — optional tooltip text (Bootstrap tooltip data API)
#}
{% apply trim %}
{% props
    ## 'primary'|'secondary'|'success'|'danger'|'warning'|'info'|'dark'|'light'|null The block color (`bg-{variant}`).
    variant = null,
    ## string|null The tooltip text (`data-bs-toggle="tooltip"` and `data-bs-title`).
    tooltip = null,
%}

{% set block = html_cva(
    base: 'tracking-block',
    variants: {
        variant: {
            primary: 'bg-primary',
            secondary: 'bg-secondary',
            success: 'bg-success',
            danger: 'bg-danger',
            warning: 'bg-warning',
            info: 'bg-info',
            dark: 'bg-dark',
            light: 'bg-light',
        },
    },
) %}

<div class="{{ block.apply({variant: variant ?? ''}, attributes.render('class')) }}"{% if tooltip is not null %} data-bs-toggle="tooltip" data-bs-title="{{ tooltip }}"{% endif %} {{ attributes.without('class') }}></div>
{% endapply ~%}
