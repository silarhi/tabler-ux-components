{#
    Tabler Button — main component, shadcn-style.

    Renders a <button> by default, an <a> when `href` is set, or the element named by `tag`.

    All-in-one:
        <twig:Tabler:Button variant="primary">Save</twig:Tabler:Button>
        <twig:Tabler:Button variant="danger" appearance="outline" size="sm">Delete</twig:Tabler:Button>
        <twig:Tabler:Button href="/profile" variant="secondary" appearance="ghost">Profile</twig:Tabler:Button>

    A file input's trigger (a <label> opens the file picker, a <button> cannot):
        <twig:Tabler:Button tag="label" icon="upload">
            <input type="file" name="import" class="visually-hidden"> Import
        </twig:Tabler:Button>

    Props:
      variant      — color: default | primary | secondary | success | danger | warning | info | dark | light
                     (`default` is Tabler's neutral button: plain .btn, .btn-outline or .btn-ghost)
      appearance   — filled (default) | outline | ghost | link (btn-link) | action (btn-action: quiet icon
                     button for card headers and table rows; give it an aria-label) — link and action ignore `variant`
      size         — sm | md (default) | lg | xl
      href         — when set, renders <a href> instead of <button> (unless `tag` names another element)
      tag          — button | a | label | span: the root element; null (default) picks <a> with `href`, else
                     <button>. A label or span gets no `type`, `href` nor `role`
      type         — button (default) | submit | reset (only on a <button>)
      pill         — fully rounded corners
      square       — remove border radius
      iconOnly     — icon-only button (no label padding)
      loading      — show loading spinner state
      block        — full width (w-100)
      disabled     — inactive state (attribute on <button>; .disabled class and aria-disabled on the others,
                     plus tabindex="-1" on <a>)
      floating     — pinned to the bottom corner of the viewport (btn-floating)
      animateIcon  — animate the icon on hover: pulse | rotate | shake | tada | move-start (btn-animate-icon-*)
      icon         — leading icon name (Tabler, or ux-icons with a prefix: `lucide:check`), rendered with
                     <twig:Tabler:Icon> and the `icon` class; mirrored by the `icon` block
      iconEnd      — trailing icon name (`icon icon-end`); mirrored by the `iconEnd` block
      modal        — id of a modal to open (data-bs-toggle="modal", data-bs-target="#id", aria-controls)
      offcanvas    — id of an offcanvas to open (data-bs-toggle="offcanvas", …)
      collapse     — id of a collapsible element to toggle (data-bs-toggle="collapse", …, aria-expanded="false")
      tooltip      — tooltip text (title, data-bs-toggle="tooltip"); an icon-only button also gets it as its
                     aria-label

    Icons and icon-only buttons:
        <twig:Tabler:Button icon="plus">New user</twig:Tabler:Button>
        <twig:Tabler:Button iconEnd="arrow-right" variant="default">Next</twig:Tabler:Button>
        <twig:Tabler:Button icon="trash" iconOnly variant="danger" aria-label="Delete" />

    Triggers (Bootstrap data API):
        <twig:Tabler:Button modal="confirm-delete" variant="danger">Delete</twig:Tabler:Button>
        <twig:Tabler:Button collapse="filters" variant="default">Filters</twig:Tabler:Button>
        <twig:Tabler:Button icon="settings" iconOnly tooltip="Settings" />

    Bootstrap reads a single `data-bs-toggle`: set one of `modal`, `offcanvas` and `collapse` (the first set
    wins, in that order). They take precedence over `tooltip`, which then only sets the native `title`; for a
    Bootstrap tooltip on such a trigger, wrap it in <twig:Tabler:Tooltip>. Explicit attributes
    (`data-bs-target`, `aria-expanded`, `aria-label`…) win over the generated ones.
#}
{% apply trim %}
{% props
    ## 'default'|'primary'|'secondary'|'success'|'danger'|'warning'|'info'|'dark'|'light' The button color; `default` is neutral.
    variant = 'primary',
    ## 'filled'|'outline'|'ghost'|'link'|'action' The button style; `link` and `action` ignore `variant`.
    appearance = 'filled',
    ## 'sm'|'md'|'lg'|'xl' The button size.
    size = 'md',
    ## string|null The link target; renders an `<a>` instead of a `<button>` when set.
    href = null,
    ## 'button'|'a'|'label'|'span'|null The root element; `null` renders an `<a>` when `href` is set, else a `<button>`. A `label` or a `span` gets no `type`, `href` nor `role`.
    tag = null,
    ## 'button'|'submit'|'reset' The `<button>` type, ignored on the other elements.
    type = 'button',
    ## bool Whether to fully round the corners (`btn-pill`).
    pill = false,
    ## bool Whether to remove the border radius (`btn-square`).
    square = false,
    ## bool Whether the button holds only an icon (`btn-icon`).
    iconOnly = false,
    ## bool Whether to show a spinner instead of the label (`btn-loading`).
    loading = false,
    ## bool Whether to take the full width (`w-100`).
    block = false,
    ## bool Whether the button is disabled: the `disabled` attribute on a `<button>`, the `disabled` class and `aria-disabled` on the other elements.
    disabled = false,
    ## bool Whether to pin the button to the bottom corner of the viewport (`btn-floating`).
    floating = false,
    ## 'pulse'|'rotate'|'shake'|'tada'|'move-start'|null The icon animation on hover (`btn-animate-icon-*`).
    animateIcon = null,
    ## string|null The leading icon name, rendered with `Tabler:Icon` (`icon`).
    icon = null,
    ## string|null The trailing icon name, rendered with `Tabler:Icon` (`icon icon-end`).
    iconEnd = null,
    ## string|null The id of the modal the button opens (`data-bs-toggle="modal"`).
    modal = null,
    ## string|null The id of the offcanvas the button opens (`data-bs-toggle="offcanvas"`).
    offcanvas = null,
    ## string|null The id of the element the button collapses and expands (`data-bs-toggle="collapse"`).
    collapse = null,
    ## string|null The tooltip text (`title`, and `data-bs-toggle="tooltip"` unless the button is a trigger); the aria-label of an icon-only button.
    tooltip = null,
%}

{% set button = html_cva(
    base: 'btn',
    variants: {
        size: {sm: 'btn-sm', md: '', lg: 'btn-lg', xl: 'btn-xl'},
        pill: {true: 'btn-pill', false: ''},
        square: {true: 'btn-square', false: ''},
        iconOnly: {true: 'btn-icon', false: ''},
        loading: {true: 'btn-loading', false: ''},
        block: {true: 'w-100', false: ''},
        disabled: {true: 'disabled', false: ''},
        floating: {true: 'btn-floating', false: ''},
        animateIcon: {
            pulse: 'btn-animate-icon btn-animate-icon-pulse',
            rotate: 'btn-animate-icon btn-animate-icon-rotate',
            shake: 'btn-animate-icon btn-animate-icon-shake',
            tada: 'btn-animate-icon btn-animate-icon-tada',
            'move-start': 'btn-animate-icon btn-animate-icon-move-start',
        },
    },
    compound_variants: [
        {appearance: ['filled'], variant: ['primary'], class: 'btn-primary'},
        {appearance: ['filled'], variant: ['secondary'], class: 'btn-secondary'},
        {appearance: ['filled'], variant: ['success'], class: 'btn-success'},
        {appearance: ['filled'], variant: ['danger'], class: 'btn-danger'},
        {appearance: ['filled'], variant: ['warning'], class: 'btn-warning'},
        {appearance: ['filled'], variant: ['info'], class: 'btn-info'},
        {appearance: ['filled'], variant: ['dark'], class: 'btn-dark'},
        {appearance: ['filled'], variant: ['light'], class: 'btn-light'},
        {appearance: ['link'], class: 'btn-link'},
        {appearance: ['action'], class: 'btn-action'},
        {appearance: ['outline'], variant: ['default'], class: 'btn-outline'},
        {appearance: ['outline'], variant: ['primary'], class: 'btn-outline-primary'},
        {appearance: ['outline'], variant: ['secondary'], class: 'btn-outline-secondary'},
        {appearance: ['outline'], variant: ['success'], class: 'btn-outline-success'},
        {appearance: ['outline'], variant: ['danger'], class: 'btn-outline-danger'},
        {appearance: ['outline'], variant: ['warning'], class: 'btn-outline-warning'},
        {appearance: ['outline'], variant: ['info'], class: 'btn-outline-info'},
        {appearance: ['outline'], variant: ['dark'], class: 'btn-outline-dark'},
        {appearance: ['outline'], variant: ['light'], class: 'btn-outline-light'},
        {appearance: ['ghost'], variant: ['default'], class: 'btn-ghost'},
        {appearance: ['ghost'], variant: ['primary'], class: 'btn-ghost-primary'},
        {appearance: ['ghost'], variant: ['secondary'], class: 'btn-ghost-secondary'},
        {appearance: ['ghost'], variant: ['success'], class: 'btn-ghost-success'},
        {appearance: ['ghost'], variant: ['danger'], class: 'btn-ghost-danger'},
        {appearance: ['ghost'], variant: ['warning'], class: 'btn-ghost-warning'},
        {appearance: ['ghost'], variant: ['info'], class: 'btn-ghost-info'},
        {appearance: ['ghost'], variant: ['dark'], class: 'btn-ghost-dark'},
        {appearance: ['ghost'], variant: ['light'], class: 'btn-ghost-light'},
    ],
) %}

{% set element = tag ?? (href is not null ? 'a' : 'button') %}
{% set link = element == 'a' %}
{% set classes = button.apply({size: size, pill: pill, square: square, iconOnly: iconOnly, loading: loading, block: block, disabled: element != 'button' and disabled, floating: floating, animateIcon: animateIcon ?? '', appearance: appearance, variant: variant}, attributes.render('class')) %}

{# Generated attributes, given as defaults so the user's explicit attributes win #}
{% set defaults = link ? {role: 'button'} : {} %}
{% set toggle = modal is not null ? 'modal' : (offcanvas is not null ? 'offcanvas' : (collapse is not null ? 'collapse' : null)) %}
{% if toggle is not null %}
    {% set target = modal ?? offcanvas ?? collapse %}
    {% set defaults = defaults|merge({'data-bs-toggle': toggle, 'data-bs-target': '#' ~ target, 'aria-controls': target}) %}
    {% if toggle == 'collapse' %}
        {% set defaults = defaults|merge({'aria-expanded': 'false'}) %}
    {% endif %}
{% endif %}
{% if tooltip is not null %}
    {% set defaults = defaults|merge(toggle is null ? {'data-bs-toggle': 'tooltip', title: tooltip} : {title: tooltip}) %}
    {% if iconOnly %}
        {% set defaults = defaults|merge({'aria-label': tooltip}) %}
    {% endif %}
{% endif %}

<{{ element }}{% if element == 'button' %} type="{{ type }}"{% elseif link and href is not null %} href="{{ href }}"{% endif %} class="{{ classes }}" {{ attributes.defaults(defaults).without('class', 'href', 'type') }}
    {%- if disabled %}{% if element == 'button' %} disabled{% else %} aria-disabled="true"{% if link %} tabindex="-1"{% endif %}{% endif %}{% endif %}>{## The leading icon: a `Tabler:Icon` named `icon`, when set. #}
    {%- block icon %}{% if icon is not null %}<twig:Tabler:Icon name="{{ icon }}" class="icon" aria-hidden="true" />{% endif %}{% endblock -%}
    {## The button label. -#}
    {%- block content %}{% endblock -%}
    {## The trailing icon: a `Tabler:Icon` named `iconEnd`, when set. -#}
    {%- block iconEnd %}{% if iconEnd is not null %}<twig:Tabler:Icon name="{{ iconEnd }}" class="icon icon-end" aria-hidden="true" />{% endif %}{% endblock -%}
</{{ element }}>
{% endapply ~%}
