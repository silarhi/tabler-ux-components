{#
    Badge list — spaces several badges in a row and wraps them (`.badge-list`, Tabler 1.5+).

    Usage:
        <twig:Tabler:Badge:List>
            <twig:Tabler:Badge variant="primary">PHP</twig:Tabler:Badge>
            <twig:Tabler:Badge variant="success">Symfony</twig:Tabler:Badge>
        </twig:Tabler:Badge:List>

    All-in-one (`items` is an array of Badge props: {text, variant?, icon?, light?, outline?, pill?, size?, href?, tooltip?}):
        <twig:Tabler:Badge:List items="{{ [
            {text: 'PHP', variant: 'primary', icon: 'brand-php'},
            {text: 'Symfony', variant: 'success', light: true},
        ] }}" />

    Props:
      items  — optional array of badges; mirrored by the `content` block
#}
{% apply trim %}
{% props
    ## list<array{text:string,variant?:string,icon?:string,light?:bool,outline?:bool,pill?:bool,size?:string,href?:string,tooltip?:string}>|null The badges, rendered with `Tabler:Badge`.
    items = null,
%}

<div {{ attributes.defaults({class: 'badge-list'}) }}>{## The badges: a `Tabler:Badge` for each entry of `items`. #}
    {%- block content -%}
        {%- for item in items ?? [] -%}
            <twig:Tabler:Badge
                variant="{{ item.variant ?? 'primary' }}"
                icon="{{ item.icon ?? null }}"
                light="{{ item.light ?? false }}"
                outline="{{ item.outline ?? false }}"
                pill="{{ item.pill ?? false }}"
                size="{{ item.size ?? 'md' }}"
                href="{{ item.href ?? null }}"
                tooltip="{{ item.tooltip ?? null }}"
            >{{ item.text ?? '' }}</twig:Tabler:Badge>
        {%- endfor -%}
    {%- endblock -%}
</div>
{% endapply ~%}
