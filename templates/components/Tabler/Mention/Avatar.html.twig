{#
    Mention avatar — the round picture of a person at the start of a mention
    (`.mention-avatar`).

    Usage:
        <twig:Tabler:Mention:Avatar image="/avatars/jane.jpg" />

    Props:
      image  — background image URL
#}
{% apply trim %}
{% props
    ## string|null The picture URL, set as the background image.
    image = null,
%}

{# the background image goes first so a user `style` can still override it #}
{% set style = [image is not null ? 'background-image: url(' ~ image ~ ')' : null, attributes.render('style')]|filter(v => v is not empty)|join('; ') %}

<span class="{{ ('mention-avatar ' ~ attributes.render('class'))|trim }}"{% if style %} style="{{ style }}"{% endif %} {{ attributes.without('class', 'style') }}></span>
{% endapply ~%}
