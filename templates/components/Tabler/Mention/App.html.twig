{#
    Mention app — the square logo of an app or a brand at the start of a
    mention (`.mention-app`).

    Usage:
        <twig:Tabler:Mention:App image="/brands/github.svg" />

    Props:
      image  — background image URL
#}
{% apply trim %}
{% props
    image = null,
%}

{# Tabler resets .mention-app's background, so bg-cover scales the logo to the box; a user `style` goes last #}
{% set style = [image is not null ? 'background-image: url(' ~ image|replace({'\\': '\\\\', '"': '\\"', "'": "\\'", '(': '\\(', ')': '\\)', ' ': '\\ ', '\n': '\\a ', '\r': '\\d ', '\t': '\\9 ', '\f': '\\c '}) ~ ')' : null, attributes.render('style')]|filter(v => v is not empty)|join('; ') %}

<span class="{{ ('mention-app' ~ (image is not null ? ' bg-cover' : '') ~ ' ' ~ attributes.render('class'))|trim }}"{% if style %} style="{{ style }}"{% endif %} {{ attributes.without('class', 'style') }}></span>
{% endapply %}
