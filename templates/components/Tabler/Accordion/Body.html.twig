{#
    Accordion body — the content of an accordion panel (`.accordion-body`).

    Usage:
        <twig:Tabler:Accordion:Body>Generate tokens and control access scopes.</twig:Tabler:Accordion:Body>
#}
{% apply trim %}
<div {{ attributes.defaults({class: 'accordion-body'}) }}>{## The panel content. #}{%- block content %}{% endblock -%}</div>
{% endapply ~%}
