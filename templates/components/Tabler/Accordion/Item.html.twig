{#
    Accordion item — one collapsible section of a <twig:Tabler:Accordion>.

    All-in-one:
        <twig:Tabler:Accordion:Item id="faq-billing" parent="faq" title="Billing details" text="View invoices." open />
        <twig:Tabler:Accordion:Item id="faq-team" title="Team profile" icon="user" plus />

    Override the `title` block (the button label) or the `body` block (the panel
    content) while keeping the generated header and collapse wiring:
        <twig:Tabler:Accordion:Item id="faq-hooks" parent="faq" title="Webhooks">
            <twig:block name="body">
                <twig:Tabler:Accordion:Body>Manage <strong>delivery URLs</strong>.</twig:Tabler:Accordion:Body>
            </twig:block>
        </twig:Tabler:Accordion:Item>

    Composed (replace `content` with the raw parts — keep the ids in sync):
        <twig:Tabler:Accordion:Item>
            <twig:Tabler:Accordion:Header>
                <twig:Tabler:Accordion:Button target="faq-api" open>API access</twig:Tabler:Accordion:Button>
            </twig:Tabler:Accordion:Header>
            <twig:Tabler:Accordion:Collapse id="faq-api" parent="faq" open>
                <twig:Tabler:Accordion:Body>Generate tokens.</twig:Tabler:Accordion:Body>
            </twig:Tabler:Accordion:Collapse>
        </twig:Tabler:Accordion:Item>

    Props:
      id          — id of the collapsible panel, targeted by the button
      parent      — id of the accordion; when set, opening this item closes the others (data-bs-parent)
      title       — button label; mirrored by the `title` block
      text        — panel text; mirrored by the `body` block
      open        — expanded on load
      icon        — optional leading Tabler icon name (accordion-button-icon)
      plus        — plus indicator that turns into a close icon (accordion-button-toggle-plus)
      toggleIcon  — Tabler icon name of the indicator (default chevron-down, or plus)
      level       — heading level of the header, 1 to 6 (default 3)
#}
{% props
    id = null,
    parent = null,
    title = null,
    text = null,
    open = false,
    icon = null,
    plus = false,
    toggleIcon = null,
    level = 3,
%}

{% set title_html %}{% block title %}{{ title }}{% endblock %}{% endset %}
{% set body_html %}{% block body %}
    {%- if text is not null -%}<twig:Tabler:Accordion:Body>{{ text }}</twig:Tabler:Accordion:Body>{%- endif -%}
{% endblock %}{% endset %}

<div {{ attributes.defaults({class: 'accordion-item'}) }}>
    {%- block content -%}
        {% block header %}
            <twig:Tabler:Accordion:Header level="{{ level }}">
                <twig:Tabler:Accordion:Button target="{{ id }}" open="{{ open }}" icon="{{ icon }}" plus="{{ plus }}" toggleIcon="{{ toggleIcon }}">{{ title_html }}</twig:Tabler:Accordion:Button>
            </twig:Tabler:Accordion:Header>
        {% endblock %}
        <twig:Tabler:Accordion:Collapse id="{{ id }}" parent="{{ parent }}" open="{{ open }}">{{ body_html }}</twig:Tabler:Accordion:Collapse>
    {%- endblock -%}
</div>
