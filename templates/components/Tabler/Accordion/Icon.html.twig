{#
    Accordion icon — a small leading icon before the label of an accordion
    button (`.accordion-button-icon`).

    Usage:
        <twig:Tabler:Accordion:Icon><twig:Tabler:Icon name="user" /></twig:Tabler:Accordion:Icon>
#}
{% apply trim %}
<span {{ attributes.defaults({class: 'accordion-button-icon'}) }}>{## The icon, e.g. a `Tabler:Icon`. #}{%- block content %}{% endblock -%}</span>
{% endapply ~%}
