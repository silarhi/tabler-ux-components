{#
    Tabler Spinner — loading indicator.

    All-in-one:
        <twig:Tabler:Spinner />
        <twig:Tabler:Spinner variant="primary" size="sm" />
        <twig:Tabler:Spinner type="grow" variant="success" />

    Props:
      type   — border (default) | grow
      variant  — primary | secondary | success | danger | warning | info | dark | light
      size   — md (default) | sm
      label  — visually-hidden status text (accessibility)
#}
{% props
    type = 'border',
    variant = null,
    size = 'md',
    label = null,
%}

{% set spinner = html_cva(
    base: '',
    variants: {
        type: {border: 'spinner-border', grow: 'spinner-grow'},
        variant: {
            primary: 'text-primary',
            secondary: 'text-secondary',
            success: 'text-success',
            danger: 'text-danger',
            warning: 'text-warning',
            info: 'text-info',
            dark: 'text-dark',
            light: 'text-light',
        },
    },
    compound_variants: [
        {type: ['border'], size: ['sm'], class: 'spinner-border-sm'},
        {type: ['grow'], size: ['sm'], class: 'spinner-grow-sm'},
    ],
) %}

<div class="{{ spinner.apply({type: type, variant: variant, size: size}, attributes.render('class')) }}" role="status" {{ attributes.without('class') }}>
    {%- block content -%}
        {%- if label is not null -%}<span class="visually-hidden">{{ label }}</span>{%- endif -%}
    {%- endblock -%}
</div>
