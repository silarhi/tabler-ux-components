{#
    Tabs item — one tab in a <twig:Tabler:Tabs>.

    Usage:
        <twig:Tabler:Tabs:Item target="home" active>Home</twig:Tabler:Tabs:Item>

    Props:
      target  — id of the pane this tab activates (without #)
      active  — the initially-selected tab
#}
{% apply trim %}
{% props
    ## string The `id` of the pane it shows, without `#`.
    target,
    ## bool Whether the tab is selected first.
    active = false,
%}

{% set link = html_cva(
    base: 'nav-link',
    variants: {
        active: {true: 'active', false: ''},
    },
) %}

<li class="nav-item" role="presentation">
    <a href="#{{ target }}" class="{{ link.apply({active: active}, attributes.render('class')) }}" data-bs-toggle="tab" {{ attributes.without('class', 'href') }}>{## The tab label. #}{%- block content %}{% endblock -%}</a>
</li>
{% endapply ~%}
