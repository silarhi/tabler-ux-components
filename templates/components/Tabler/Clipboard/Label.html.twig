{#
    Clipboard label — the resting state of a <twig:Tabler:Clipboard> (`.clipboard-label`).

    Usage:
        <twig:Tabler:Clipboard:Label>Copy link</twig:Tabler:Clipboard:Label>
#}
{% apply trim %}
<span {{ attributes.defaults({class: 'clipboard-label'}) }}>{%- block content %}{% endblock -%}</span>
{% endapply ~%}
