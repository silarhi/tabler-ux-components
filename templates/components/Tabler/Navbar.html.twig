{#
    Tabler Navbar — a responsive navigation header, or a vertical sidebar.

    Horizontal (composed):
        <twig:Tabler:Navbar>
            <twig:Tabler:Navbar:Toggler target="navbar-menu" />
            <twig:Tabler:Navbar:Brand href="/">My App</twig:Tabler:Navbar:Brand>
            <twig:Tabler:Navbar:Nav id="navbar-menu" collapse>
                <twig:Tabler:Navbar:Item href="/" icon="home" active>Home</twig:Tabler:Navbar:Item>
                <twig:Tabler:Navbar:Item href="/profile" icon="user">Profile</twig:Tabler:Navbar:Item>
            </twig:Tabler:Navbar:Nav>
        </twig:Tabler:Navbar>

    Vertical sidebar (renders an <aside>, folded into an icon rail that unfolds on hover):
        <twig:Tabler:Navbar vertical expand="lg" folded="hover">
            <twig:Tabler:Navbar:Toggler target="sidebar-menu" />
            <twig:Tabler:Navbar:Brand href="/">My App</twig:Tabler:Navbar:Brand>
            <twig:Tabler:Navbar:Nav id="sidebar-menu" collapse>
                <twig:Tabler:Navbar:SectionTitle>Overview</twig:Tabler:Navbar:SectionTitle>
                <twig:Tabler:Navbar:Item href="/" icon="home" active>Home</twig:Tabler:Navbar:Item>
            </twig:Tabler:Navbar:Nav>
            <twig:Tabler:Navbar:Footer>
                <twig:Tabler:Navbar:Item href="/profile" icon="user">Profile</twig:Tabler:Navbar:Item>
            </twig:Tabler:Navbar:Footer>
        </twig:Tabler:Navbar>

    Props:
      expand     — sm | md (default) | lg | xl | none (when the menu un-collapses)
      dark       — dark theme (navbar-dark)
      container  — container width suffix: xl | fluid | lg | … (default: xl, or fluid when vertical)
      vertical   — vertical sidebar (navbar-vertical), rendered as an <aside>
      folded     — vertical only: fold into an icon rail; `hover` unfolds it on hover/focus
                   (navbar-folded / navbar-folded-hover, Tabler 1.5+)
      floating   — gap between the navbar and the edges around it (navbar-floating, Tabler 1.6+)
#}
{% apply trim %}
{% props
    ## 'sm'|'md'|'lg'|'xl'|'none' The breakpoint where the menu un-collapses (`navbar-expand-*`).
    expand = 'md',
    ## bool Whether to use light text colors for a dark background (`navbar-dark`).
    dark = false,
    ## string|null The suffix of the inner `container-*`; `xl`, or `fluid` when vertical, by default.
    container = null,
    ## bool Whether to render a vertical sidebar (`navbar-vertical`) as an `<aside>`.
    vertical = false,
    ## bool|'hover' Vertical only: `true` folds it into an icon rail (`navbar-folded`), `hover` also unfolds it on hover (`navbar-folded-hover`).
    folded = false,
    ## bool Whether to add a gap between the navbar and the edges around it (`navbar-floating`).
    floating = false,
%}

{% set navbar = html_cva(
    base: 'navbar d-print-none',
    variants: {
        expand: {
            sm: 'navbar-expand-sm',
            md: 'navbar-expand-md',
            lg: 'navbar-expand-lg',
            xl: 'navbar-expand-xl',
            none: '',
        },
        dark: {true: 'navbar-dark', false: ''},
        vertical: {true: 'navbar-vertical', false: ''},
        folded: {true: 'navbar-folded', hover: 'navbar-folded-hover', false: ''},
        floating: {true: 'navbar-floating', false: ''},
    },
) %}

{% set tag = vertical ? 'aside' : 'header' %}
<{{ tag }} class="{{ navbar.apply({expand: expand, dark: dark, vertical: vertical, folded: folded, floating: floating}, attributes.render('class')) }}" {{ attributes.without('class') }}>
    <div class="container-{{ container ?? (vertical ? 'fluid' : 'xl') }}">
        {## The navbar content, inside the container: `Navbar:Toggler`, `Navbar:Brand`, `Navbar:Nav` and the like. -#}
        {% block content %}{% endblock %}
    </div>
</{{ tag }}>
{% endapply ~%}
