{#
    Breadcrumb item — one crumb in a <twig:Tabler:Breadcrumb>.

    Usage:
        <twig:Tabler:Breadcrumb:Item href="/">Home</twig:Tabler:Breadcrumb:Item>
        <twig:Tabler:Breadcrumb:Item active>Current</twig:Tabler:Breadcrumb:Item>

    Props:
      href    — link target; when omitted the crumb is plain text
      active  — marks the current page (no link)
#}
{% apply trim %}
{% props
    ## string|null The link target; without it, the crumb is plain text.
    href = null,
    ## bool Whether the crumb is the current page, rendered without a link (`active`).
    active = false,
%}

{% set item = html_cva(
    base: 'breadcrumb-item',
    variants: {
        active: {true: 'active', false: ''},
    },
) %}

<li class="{{ item.apply({active: active}, attributes.render('class')) }}"{% if active %} aria-current="page"{% endif %} {{ attributes.without('class', 'href') }}>
    {%- set link = href is not null and not active -%}
    {%- if link %}<a href="{{ href }}">{% endif -%}
    {## The crumb label, inside the link when there is one. -#}
    {%- block content %}{% endblock -%}
    {%- if link %}</a>{% endif -%}
</li>
{% endapply ~%}
