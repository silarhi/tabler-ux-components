{#
    Navbar item — one entry in a <twig:Tabler:Navbar:Nav>.

    Usage:
        <twig:Tabler:Navbar:Item href="/" icon="home" active>Home</twig:Tabler:Navbar:Item>

    Props:
      href    — link target (defaults to #)
      active  — marks the current page
      icon    — optional leading Tabler icon name
#}
{% apply trim %}
{% props
    ## string|null The link target; defaults to `#`.
    href = null,
    ## bool Whether it marks the current page (`active`, `aria-current="page"`).
    active = false,
    ## string|null The leading Tabler icon name, rendered with `Tabler:Icon`.
    icon = null,
%}

{% set item = html_cva(
    base: 'nav-item',
    variants: {
        active: {true: 'active', false: ''},
    },
) %}

<li class="{{ item.apply({active: active}, attributes.render('class')) }}" {{ attributes.without('class', 'href') }}>
    <a class="nav-link" href="{{ href ?? '#' }}"{% if active %} aria-current="page"{% endif %}>
        {%- if icon is not null -%}<span class="nav-link-icon"><twig:Tabler:Icon name="{{ icon }}" /></span>{%- endif -%}
        <span class="nav-link-title">{## The item title. #}{%- block content %}{% endblock -%}</span>
    </a>
</li>
{% endapply ~%}
