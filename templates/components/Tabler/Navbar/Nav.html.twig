{#
    Navbar nav — the list of nav items. Optionally wrapped in a collapse panel.

    Usage:
        <twig:Tabler:Navbar:Nav id="navbar-menu" collapse>
            <twig:Tabler:Navbar:Item href="/" active>Home</twig:Tabler:Navbar:Item>
        </twig:Tabler:Navbar:Nav>

    Trailing entries go in the `side` block, rendered after the list inside the
    collapse panel (see <twig:Tabler:Navbar:Side>).

    Props:
      collapse  — wrap in `.collapse.navbar-collapse` (pairs with a Toggler)
      id        — id targeted by the toggler (required when `collapse`)
#}
{% apply trim %}
{% props
    collapse = false,
    id = null,
%}

{% if collapse %}<div class="collapse navbar-collapse"{% if id is not null %} id="{{ id }}"{% endif %}>{% endif %}
<ul {{ attributes.defaults({class: 'navbar-nav'}).without('id') }}>{% block content %}{% endblock %}</ul>
{%- block side %}{% endblock -%}
{% if collapse %}</div>{% endif %}
{% endapply %}
