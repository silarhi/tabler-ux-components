{#
    Tabler Ribbon — a corner ribbon, placed inside a positioned parent (e.g. a card).

    All-in-one:
        <twig:Tabler:Ribbon variant="green">NEW</twig:Tabler:Ribbon>
        <twig:Tabler:Ribbon variant="orange" position="top-start" bookmark>★</twig:Tabler:Ribbon>

    Props:
      variant     — primary | secondary | success | danger | warning | info | dark | light
      position  — end (default, top-right) | start | top | top-start | bottom | bottom-start
      bookmark  — bookmark-style ribbon
#}
{% props
    variant = null,
    position = 'end',
    bookmark = false,
%}

{% set ribbon = html_cva(
    base: 'ribbon',
    variants: {
        variant: {
            primary: 'bg-primary',
            secondary: 'bg-secondary',
            success: 'bg-success',
            danger: 'bg-danger',
            warning: 'bg-warning',
            info: 'bg-info',
            dark: 'bg-dark',
            light: 'bg-light',
        },
        position: {
            end: '',
            start: 'ribbon-start',
            top: 'ribbon-top',
            'top-start': 'ribbon-top ribbon-start',
            bottom: 'ribbon-bottom',
            'bottom-start': 'ribbon-bottom ribbon-start',
        },
        bookmark: {true: 'ribbon-bookmark', false: ''},
    },
) %}

<div class="{{ ribbon.apply({variant: variant, position: position, bookmark: bookmark}, attributes.render('class')) }}" {{ attributes.without('class') }}>{%- block content %}{% endblock -%}</div>
