{#
    Tabler Icon — renders a Tabler icon via the icon webfont (@tabler/icons-webfont).

    All-in-one:
        <twig:Tabler:Icon name="check" />
        <twig:Tabler:Icon name="heart" variant="danger" />
        <twig:Tabler:Icon name="refresh" animation="rotate" />

    Props:
      name       — Tabler icon name (without the `ti-` prefix)
      variant      — primary | secondary | success | danger | warning | info | dark | light
      animation  — pulse | tada | rotate
      size       — sm (1rem) | md (2.5rem) | lg (3.5rem) | inline (1rem, aligned with text);
                   unset, the icon follows the surrounding font size
      filled     — use the filled variant of the icon (ti-{name}-filled)

    Requires the @tabler/icons-webfont stylesheet to be loaded.
#}
{% props
    name,
    variant = null,
    animation = null,
    size = null,
    filled = false,
%}

{% set icon = html_cva(
    base: 'ti',
    variants: {
        variant: {
            primary: 'text-primary',
            secondary: 'text-secondary',
            success: 'text-success',
            danger: 'text-danger',
            warning: 'text-warning',
            info: 'text-info',
            dark: 'text-dark',
            light: 'text-light',
        },
        animation: {
            pulse: 'icon-pulse',
            tada: 'icon-tada',
            rotate: 'icon-rotate',
        },
        size: {
            sm: 'icon icon-sm',
            md: 'icon icon-md',
            lg: 'icon icon-lg',
            inline: 'icon icon-inline',
        },
    },
) %}

<i class="{{ icon.apply({variant: variant ?? '', animation: animation ?? '', size: size ?? ''}, 'ti-' ~ name ~ (filled ? '-filled' : ''), attributes.render('class')) }}" {{ attributes.without('class') }}></i>
