{#
    Chat bubble author — the sender name in a bubble title (`.chat-bubble-author`).

    Usage:
        <twig:Tabler:Chat:Bubble:Author>Alice Marlin</twig:Tabler:Chat:Bubble:Author>
#}
{% apply trim %}
<div {{ attributes.defaults({class: 'col chat-bubble-author'}) }}>{%- block content %}{% endblock -%}</div>
{% endapply ~%}
