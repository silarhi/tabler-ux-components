{#
    Chat message — one row of a chat: the sender's avatar next to a bubble.
    Messages from other people read avatar first; `me` messages are pushed to
    the far side with the bubble first.

    All-in-one:
        <twig:Tabler:Chat:Message author="Alice Marlin" date="10:24" text="Hey!" avatar="/avatars/alice.jpg" />
        <twig:Tabler:Chat:Message author="You" date="10:26" text="Sure." avatar="/avatars/me.jpg" me />

    Composed (override `content` with the bubble, or the `avatar` block):
        <twig:Tabler:Chat:Message me>
            <twig:block name="avatar"><twig:Tabler:Avatar size="xs">GS</twig:Tabler:Avatar></twig:block>
            <twig:Tabler:Chat:Bubble me text="Sure, give me five minutes." />
        </twig:Tabler:Chat:Message>

    Props:
      author  — sender name; passed to the bubble title
      date    — time of the message; passed to the bubble title
      text    — message text; passed to the bubble body
      avatar  — sender avatar image URL; mirrored by the `avatar` block
      me      — sent by the current user (chat-bubble-me, row aligned to the end)
#}
{% apply trim %}
{% props
    author = null,
    date = null,
    text = null,
    avatar = null,
    me = false,
%}

{% set avatar_html %}{% block avatar %}
    {%- if avatar is not null -%}<span class="avatar" style="background-image: url({{ avatar }})"></span>{%- endif -%}
{% endblock %}{% endset %}

<div {{ attributes }}>
    <div class="row align-items-end{{ me ? ' justify-content-end' : '' }}">
        {%- if not me and avatar_html|trim is not empty -%}<div class="col-auto">{{ avatar_html }}</div>{%- endif -%}
        <div class="col-auto">
            {%- block content -%}
                <twig:Tabler:Chat:Bubble me="{{ me }}" author="{{ author }}" date="{{ date }}" text="{{ text }}" />
            {%- endblock -%}
        </div>
        {%- if me and avatar_html|trim is not empty -%}<div class="col-auto">{{ avatar_html }}</div>{%- endif -%}
    </div>
</div>
{% endapply %}
