{#
    Chat bubbles — stacks the message rows of a chat with a consistent gap
    (`.chat-bubbles`).

    Usage:
        <twig:Tabler:Chat:Bubbles>
            <twig:Tabler:Chat:Message author="Alice" text="Hey!" />
        </twig:Tabler:Chat:Bubbles>
#}
{% apply trim %}
<div {{ attributes.defaults({class: 'chat-bubbles'}) }}>{%- block content %}{% endblock -%}</div>
{% endapply %}
