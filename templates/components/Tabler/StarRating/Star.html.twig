{#
    StarRating star — one star of a <twig:Tabler:StarRating> (`.star`).
    Only active stars take the color; the others keep the muted default.

    Usage:
        <twig:Tabler:StarRating:Star active />
        <twig:Tabler:StarRating:Star active variant="orange" icon="heart" />

    Props:
      active   — colored (counted) star
      variant  — color when active (default yellow), any color accepted by <twig:Tabler:StarRating>
      icon     — Tabler icon name (default star); mirrored by the `content` block
      filled   — filled icon (see <twig:Tabler:Icon filled>)
#}
{% apply trim %}
{% props
    ## bool Whether to color the star with `variant`; inactive stars stay gray.
    active = false,
    ## 'primary'|'secondary'|'success'|'danger'|'warning'|'info'|'dark'|'light'|'muted'|'blue'|'azure'|'indigo'|'purple'|'pink'|'red'|'orange'|'yellow'|'lime'|'green'|'teal'|'cyan' The color when active.
    variant = 'yellow',
    ## string The Tabler icon name.
    icon = 'star',
    ## bool Whether to use a filled icon.
    filled = false,
%}

{% set star = html_cva(
    base: 'star',
    variants: {
        variant: {
            primary: 'text-primary',
            secondary: 'text-secondary',
            success: 'text-success',
            danger: 'text-danger',
            warning: 'text-warning',
            info: 'text-info',
            dark: 'text-dark',
            light: 'text-light',
            muted: 'text-muted',
            blue: 'text-blue',
            azure: 'text-azure',
            indigo: 'text-indigo',
            purple: 'text-purple',
            pink: 'text-pink',
            red: 'text-red',
            orange: 'text-orange',
            yellow: 'text-yellow',
            lime: 'text-lime',
            green: 'text-green',
            teal: 'text-teal',
            cyan: 'text-cyan',
        },
    },
) %}

<span class="{{ star.apply({variant: active ? (variant ?? '') : ''}, attributes.render('class')) }}" {{ attributes.without('class') }}>{## The `icon`, hidden from assistive technology. #}
    {%- block content -%}<twig:Tabler:Icon name="{{ icon }}" filled="{{ filled }}" aria-hidden="true" />{%- endblock -%}
</span>
{% endapply ~%}
