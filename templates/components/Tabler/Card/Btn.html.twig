{#
    Card button — a full-width action along the bottom edge of a card (`.card-btn`).
    Several of them share the edge when wrapped in a `.d-flex` div.

    Usage:
        <twig:Tabler:Card:Btn href="/profile">View profile</twig:Tabler:Card:Btn>

    Props:
      href  — when set, renders <a href>; otherwise a <button type="button">
#}
{% props
    href = null,
%}

{%- set label -%}{%- block content %}{% endblock -%}{%- endset -%}

{% if href is not null %}
    <a href="{{ href }}" {{ attributes.defaults({class: 'card-btn'}).without('href') }}>{{- label|raw -}}</a>
{% else %}
    <button type="button" {{ attributes.defaults({class: 'card-btn'}).without('type') }}>{{- label|raw -}}</button>
{% endif %}
