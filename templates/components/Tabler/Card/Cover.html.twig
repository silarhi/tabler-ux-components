{#
    Card cover — a header with a background photo darkened by an overlay, so white
    text on top stays readable (`.card-cover`). The content is wrapped in a
    `position-relative` <div>, which keeps it above the overlay. Put `text-white` on
    the text itself: headings set their own color, so they ignore it on the cover.

    Usage:
        <twig:Tabler:Card:Cover image="/photos/books.jpg" class="text-center">
            <div class="h1 m-0 text-white">Reading list</div>
        </twig:Tabler:Card:Cover>

    Props:
      image    — background image URL
      blurred  — blur the photo behind the overlay (card-cover-blurred)
#}
{% apply trim %}
{% props
    image = null,
    blurred = false,
%}

{% set style = [image is not null ? 'background-image: url(' ~ image ~ ')' : null, attributes.render('style')]|filter(v => v is not empty)|join('; ') %}

{# the overlay is an absolutely positioned ::before: the content needs its own stacking to stay above it #}
<div {{ attributes.defaults({class: blurred ? 'card-cover card-cover-blurred' : 'card-cover'}).without('style') }}{% if style %} style="{{ style }}"{% endif %}>
    <div class="position-relative">{%- block content %}{% endblock -%}</div>
</div>
{% endapply ~%}
