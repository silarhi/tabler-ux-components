{#
    Card footer — the bottom section of a card.

    Usage:
      <twig:Tabler:Card:Footer>Last updated 3 days ago</twig:Tabler:Card:Footer>
#}
{% apply trim %}
<div {{ attributes.defaults({class: 'card-footer'}) }}>{## The footer content. #}{%- block content %}{% endblock -%}</div>
{% endapply ~%}
