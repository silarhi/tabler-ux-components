{#
    Card meta — a muted secondary line, e.g. a role or a date (`.card-meta`).

    Usage:
        <twig:Tabler:Card:Meta>Updated 3 days ago</twig:Tabler:Card:Meta>
#}
{% apply trim %}
<div {{ attributes.defaults({class: 'card-meta'}) }}>{## The muted text. #}{%- block content %}{% endblock -%}</div>
{% endapply ~%}
