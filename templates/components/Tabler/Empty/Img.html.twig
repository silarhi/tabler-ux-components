{#
    Empty image — a leading illustration of an empty state (`.empty-img`, slot-only).

    Usage:
        <twig:Tabler:Empty:Img><img src="/illustrations/empty.svg" height="128" alt=""></twig:Tabler:Empty:Img>
#}
{% apply trim %}
<div {{ attributes.defaults({class: 'empty-img'}) }}>{%- block content %}{% endblock -%}</div>
{% endapply ~%}
