{#
    Carousel control — a previous/next arrow for a <twig:Tabler:Carousel>.

    Usage:
        <twig:Tabler:Carousel:Control target="hero" direction="prev" />
        <twig:Tabler:Carousel:Control target="hero" direction="next" />

    Props:
      target     — id of the carousel this control drives
      direction  — prev | next
      label      — visually-hidden label (defaults to "Previous" / "Next")
#}
{% props
    target = null,
    direction = 'next',
    label = null,
%}

<a class="{{ ('carousel-control-' ~ direction ~ ' ' ~ attributes.render('class'))|trim }}"{% if target is not null %} data-bs-target="#{{ target }}"{% endif %} role="button" data-bs-slide="{{ direction }}" {{ attributes.without('class') }}>
    <span class="carousel-control-{{ direction }}-icon" aria-hidden="true"></span>
    <span class="visually-hidden">{{ label ?? (direction == 'prev' ? 'Previous' : 'Next') }}</span>
</a>
