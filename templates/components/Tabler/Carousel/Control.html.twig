{#
    Carousel control — a previous/next arrow for a <twig:Tabler:Carousel>.

    Usage:
        <twig:Tabler:Carousel:Control target="hero" direction="prev" />
        <twig:Tabler:Carousel:Control target="hero" direction="next" />

    Props:
      target     — id of the carousel this control drives
      direction  — prev | next
      label      — visually-hidden label (defaults to "Previous" / "Next")
#}
{% apply trim %}
{% props
    ## string|null The id of the carousel this control drives.
    target = null,
    ## 'prev'|'next' The direction of the control.
    direction = 'next',
    ## string|null The visually hidden label; defaults to `Previous` or `Next`.
    label = null,
%}

<a class="{{ ('carousel-control-' ~ direction ~ ' ' ~ attributes.render('class'))|trim }}"{% if target is not null %} data-bs-target="#{{ target }}"{% endif %} role="button" data-bs-slide="{{ direction }}" {{ attributes.without('class') }}>{## The arrow icon and its visually hidden label. #}
    {%- block content -%}
        <span class="carousel-control-{{ direction }}-icon" aria-hidden="true"></span>
        <span class="visually-hidden">{{ label ?? (direction == 'prev' ? 'Previous' : 'Next') }}</span>
    {%- endblock -%}
</a>
{% endapply ~%}
