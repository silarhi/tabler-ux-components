{#
    Tabler Offcanvas — a slide-in panel (Bootstrap offcanvas).

    All-in-one:
        <twig:Tabler:Offcanvas id="menu" title="Filters" text="…" />

    Composed:
        <twig:Tabler:Offcanvas id="menu" placement="end">
            <twig:Tabler:Offcanvas:Header>
                <twig:Tabler:Offcanvas:Title>Filters</twig:Tabler:Offcanvas:Title>
                <twig:Tabler:Offcanvas:Close />
            </twig:Tabler:Offcanvas:Header>
            <twig:Tabler:Offcanvas:Body>…</twig:Tabler:Offcanvas:Body>
            <twig:Tabler:Offcanvas:Footer>…</twig:Tabler:Offcanvas:Footer>
        </twig:Tabler:Offcanvas>

    Open with a trigger: data-bs-toggle="offcanvas" data-bs-target="#<id>".

    Props:
      id           — DOM id used by triggers
      placement    — start (default) | end | top | bottom
      title        — optional title; mirrored by the `header` block
      text         — optional body text; mirrored by the `body` block
      footer       — optional footer text; mirrored by the `footer` block
      dismissible  — show a close button in the header (default true)
      scrollable   — allow body scroll while open (data-bs-scroll)
      narrow       — narrower panel, 20rem (offcanvas-narrow)
      floating     — gap between the panel and the viewport edges (offcanvas-floating, Tabler 1.6+)
#}
{% apply trim %}
{% props
    ## string|null The DOM id targeted by triggers (`data-bs-target="#id"`).
    id = null,
    ## 'start'|'end'|'top'|'bottom' The edge the panel slides from.
    placement = 'start',
    ## string|null The title, rendered with `Offcanvas:Header` and `Offcanvas:Title`.
    title = null,
    ## string|null The body text, rendered with `Offcanvas:Body`.
    text = null,
    ## string|null The footer text, rendered with `Offcanvas:Footer`.
    footer = null,
    ## bool Whether to add a close button (`Offcanvas:Close`) to the header rendered from `title`.
    dismissible = true,
    ## bool Whether the page keeps scrolling while the panel is open (`data-bs-scroll`).
    scrollable = false,
    ## bool Whether to make the panel 20rem wide (`offcanvas-narrow`).
    narrow = false,
    ## bool Whether to leave a gap between the panel and the viewport edges (`offcanvas-floating`).
    floating = false,
%}

{% set offcanvas = html_cva(
    base: 'offcanvas',
    variants: {
        placement: {
            start: 'offcanvas-start',
            end: 'offcanvas-end',
            top: 'offcanvas-top',
            bottom: 'offcanvas-bottom',
        },
        narrow: {true: 'offcanvas-narrow', false: ''},
        floating: {true: 'offcanvas-floating', false: ''},
    },
) %}

<div class="{{ offcanvas.apply({placement: placement, narrow: narrow, floating: floating}, attributes.render('class')) }}" tabindex="-1"{% if id is not null %} id="{{ id }}"{% endif %}{% if scrollable %} data-bs-scroll="true"{% endif %} {{ attributes.without('class', 'id') }}>
    {## The panel content: `header`, `body` and `footer`; replace it to compose freely. -#}
    {% block content %}
        {## The header: `Offcanvas:Header` with `Offcanvas:Title` and `Offcanvas:Close` (when `dismissible`), when `title` is set. -#}
        {% block header %}
            {%- if title is not null -%}
                <twig:Tabler:Offcanvas:Header>
                    <twig:Tabler:Offcanvas:Title>{{ title }}</twig:Tabler:Offcanvas:Title>
                    {%- if dismissible -%}<twig:Tabler:Offcanvas:Close />{%- endif -%}
                </twig:Tabler:Offcanvas:Header>
            {%- endif -%}
        {% endblock %}
        {## The body: `Offcanvas:Body` with the `text` prop, when set. -#}
        {% block body %}
            {%- if text is not null -%}<twig:Tabler:Offcanvas:Body>{{ text }}</twig:Tabler:Offcanvas:Body>{%- endif -%}
        {% endblock %}
        {## The footer: `Offcanvas:Footer` with the `footer` prop, when set. -#}
        {% block footer %}
            {%- if footer is not null -%}<twig:Tabler:Offcanvas:Footer>{{ footer }}</twig:Tabler:Offcanvas:Footer>{%- endif -%}
        {% endblock %}
    {% endblock %}
</div>
{% endapply ~%}
