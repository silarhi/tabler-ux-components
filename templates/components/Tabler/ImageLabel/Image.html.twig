{#
    ImageLabel image — the image of a <twig:Tabler:ImageLabel>, which its labels are
    pinned to.

    Usage:
        <twig:Tabler:ImageLabel:Image src="/photos/book.jpg" alt="A book on the grass" class="rounded" width="240" />

    Props:
      src  — image URL
      alt  — alternative text; empty for a decorative image
#}
{% apply trim %}
{% props
    ## string The image URL.
    src,
    ## string The alternative text; empty for a decorative image.
    alt = '',
%}

<img src="{{ src }}" alt="{{ alt }}" {{ attributes.without('src', 'alt') }}>
{% endapply ~%}
