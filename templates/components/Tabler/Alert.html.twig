{#
    Tabler Alert — main component, shadcn-style.

    All-in-one:

        <twig:Tabler:Alert variant="success" icon="check" title="Saved!" description="Your changes are live." />

    Every prop has a matching block whose default renders the corresponding
    sub-component wrapping the prop value. Override any block to take full
    control while still leveraging the sub-component (and its attributes):

        <twig:Tabler:Alert variant="success" title="Saved!">
            <twig:block name="title">
                <twig:Tabler:Alert:Title class="my-extra">Custom!</twig:Tabler:Alert:Title>
            </twig:block>
        </twig:Tabler:Alert>

    Or replace the default `content` block to compose freely:

        <twig:Tabler:Alert variant="success">
            <twig:Tabler:Alert:Icon><i class="ti ti-check"></i></twig:Tabler:Alert:Icon>
            <twig:Tabler:Alert:Title>Saved!</twig:Tabler:Alert:Title>
            <twig:Tabler:Alert:Description>Your changes are live.</twig:Tabler:Alert:Description>
        </twig:Tabler:Alert>

    Props:
      variant      — primary | secondary | success | danger | warning | info
      important    — filled/solid style (alert-important)
      minor        — quiet style: plain border, no tinted background (alert-minor)
      icon         — optional Tabler icon name (or ux-icons name, `lucide:circle-check`), rendered with
                     <twig:Tabler:Icon> inside Alert:Icon; for any other markup (an inline SVG…) override
                     the `icon` block with Alert:Icon
      title        — optional title; mirrored by the `title` block
      description  — optional description; mirrored by the `description` block
      dismissible  — show a close button; mirrored by the `dismiss` block

#}
{% apply trim %}
{% props
    ## 'primary'|'secondary'|'success'|'danger'|'warning'|'info' The alert color.
    variant = 'info',
    ## bool Whether to fill the background (`alert-important`).
    important = false,
    ## bool Whether to keep a plain border, without a tinted background (`alert-minor`).
    minor = false,
    ## string|null The Tabler icon name, rendered with `Tabler:Icon` inside `Alert:Icon`.
    icon = null,
    ## string|null The title, rendered with `Alert:Title`.
    title = null,
    ## string|null The description, rendered with `Alert:Description`.
    description = null,
    ## bool Whether to add a close button (`Alert:Dismiss`).
    dismissible = false,
%}

{% set alert = html_cva(
    base: 'alert',
    variants: {
        variant: {
            primary: 'alert-primary',
            secondary: 'alert-secondary',
            success: 'alert-success',
            danger: 'alert-danger',
            warning: 'alert-warning',
            info: 'alert-info',
        },
        important: {
            true: 'alert-important',
            false: '',
        },
        minor: {
            true: 'alert-minor',
            false: '',
        },
        dismissible: {
            true: 'alert-dismissible',
            false: '',
        },
    },
    compound_variants: [
        {important: [true], class: 'text-white'},
    ],
) %}

{# Capture title/description blocks so we can decide whether to render the wrapping <div> based on actual output (not just props).
   A captured block is already escaped and marked safe: print it as is, never through |raw, and never joined with ~ (that escapes it twice). #}
{% set title_html %}{## The title: `Alert:Title` with the `title` prop, when set. #}{% block title %}
    {%- if title is not null -%}<twig:Tabler:Alert:Title>{{ title }}</twig:Tabler:Alert:Title>{%- endif -%}
{% endblock %}{% endset %}

{% set description_html %}{## The description: `Alert:Description` with the `description` prop, when set. #}{% block description %}
    {%- if description is not null -%}<twig:Tabler:Alert:Description>{{ description }}</twig:Tabler:Alert:Description>{%- endif -%}
{% endblock %}{% endset %}

{% set wrapper_class = alert.apply({variant: variant, important: important, minor: minor, dismissible: dismissible}, attributes.render('class')) %}
<div class="{{ wrapper_class }}" {{ attributes.defaults({role: 'alert'}).without('class') }}>
    {## The whole alert content: `icon`, `body` and `dismiss`; replace it to compose freely. -#}
    {% block content %}
        {## The icon: `Alert:Icon` with a `Tabler:Icon` named `icon`, when set. -#}
        {% block icon %}
            {%- if icon is not null -%}<twig:Tabler:Alert:Icon><twig:Tabler:Icon name="{{ icon }}" /></twig:Tabler:Alert:Icon>{%- endif -%}
        {% endblock %}
        {## A `<div>` around `title` and `description`, when one of them renders. -#}
        {% block body %}
            {%- if (title_html ~ description_html)|trim -%}
                <div>{{ title_html }}{{ description_html }}</div>
            {%- endif -%}
        {% endblock %}
        {## The close button: `Alert:Dismiss`, when `dismissible`. -#}
        {% block dismiss %}
            {%- if dismissible -%}<twig:Tabler:Alert:Dismiss />{%- endif -%}
        {% endblock %}
    {% endblock %}
</div>
{% endapply ~%}
