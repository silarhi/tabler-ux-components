{#
    Avatar brand — a small brand mark in the bottom corner of an avatar (`.avatar-brand`).

    Usage:
        <twig:Tabler:Avatar image="/avatars/jane.jpg">
            <twig:Tabler:Avatar:Brand image="/brands/github.svg" />
        </twig:Tabler:Avatar>

    Props:
      image  — background image URL of the mark; or put markup in the `content` block
#}
{% apply trim %}
{% props
    image = null,
%}

{# .avatar-brand sets no background size, so bg-cover scales the image to the mark; a user `style` goes last #}
{% set style = [image is not null ? 'background-image: url(' ~ image ~ ')' : null, attributes.render('style')]|filter(v => v is not empty)|join('; ') %}

<span class="{{ ('avatar-brand' ~ (image is not null ? ' bg-cover' : '') ~ ' ' ~ attributes.render('class'))|trim }}"{% if style %} style="{{ style }}"{% endif %} {{ attributes.without('class', 'style') }}>{%- block content %}{% endblock -%}</span>
{% endapply ~%}
