{#
    Switch icon state B — the second (toggled) icon of a <twig:Tabler:SwitchIcon>.

    Usage:
        <twig:Tabler:SwitchIcon:B><twig:Tabler:Icon name="sun" /></twig:Tabler:SwitchIcon:B>
#}
{% apply trim %}
<span {{ attributes.defaults({class: 'switch-icon-b'}) }}>{%- block content %}{% endblock -%}</span>
{% endapply ~%}
