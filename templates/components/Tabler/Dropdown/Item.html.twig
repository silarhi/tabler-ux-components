{#
    Dropdown item — a single action in a dropdown menu.

    Usage:
        <twig:Tabler:Dropdown:Item href="/edit">Edit</twig:Tabler:Dropdown:Item>
        <twig:Tabler:Dropdown:Item href="#" active>Selected</twig:Tabler:Dropdown:Item>

    An item holding a checkbox or a radio (Dropdown:Indicator) cannot be a link:
        <twig:Tabler:Dropdown:Item tag="label">
            <twig:Tabler:Dropdown:Indicator><input type="checkbox" class="form-check-input m-0"></twig:Tabler:Dropdown:Indicator>
            Show archived
        </twig:Tabler:Dropdown:Item>

    Props:
      tag       — a (default) | button | label | any other element; only an <a> gets the `href`
      href      — link target (defaults to #)
      active    — highlighted item
      disabled  — non-interactive item
      icon      — optional leading Tabler icon name (dropdown-item-icon)
#}
{% apply trim %}
{% props
    ## string The element, `a` by default (`button`, `label`…); only an `<a>` gets the `href`.
    tag = 'a',
    ## string|null The link target; defaults to `#`.
    href = null,
    ## bool Whether to highlight the item (`active`).
    active = false,
    ## bool Whether the item is non-interactive (`disabled`).
    disabled = false,
    ## string|null The leading Tabler icon name, rendered with `Tabler:Icon` (`dropdown-item-icon`).
    icon = null,
%}

{% set item = html_cva(
    base: 'dropdown-item',
    variants: {
        active: {true: 'active', false: ''},
        disabled: {true: 'disabled', false: ''},
    },
) %}

<{{ tag }}{% if tag == 'a' %} href="{{ href ?? '#' }}"{% elseif tag == 'button' %} type="{{ attributes.render('type') ?? 'button' }}"{% endif %} class="{{ item.apply({active: active, disabled: disabled}, attributes.render('class')) }}"
    {%- if disabled %}{% if tag == 'button' %} disabled{% else %} aria-disabled="true"{% endif %}{% endif %} {{ attributes.without('class', 'href', 'type') }}>
    {%- if icon is not null -%}<twig:Tabler:Icon name="{{ icon }}" class="dropdown-item-icon" />{%- endif -%}
    {## The item label, after the `icon`. -#}
    {%- block content %}{% endblock -%}
</{{ tag }}>
{% endapply ~%}
