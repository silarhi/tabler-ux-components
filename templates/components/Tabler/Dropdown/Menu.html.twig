{#
    Dropdown menu — the panel of items.

    All-in-one (`items` is an array of {label, href?, icon?, active?, disabled?, badge?} links,
    {divider: true} separators and {header: '…'} labels):
        <twig:Tabler:Dropdown:Menu items="{{ [
            {header: 'Invoice #1042'},
            {label: 'Edit', href: '/edit', icon: 'pencil'},
            {divider: true},
            {label: 'Delete', href: '/delete', disabled: true},
        ] }}" />

    Composed:
        <twig:Tabler:Dropdown:Menu>
            <twig:Tabler:Dropdown:Item href="/edit">Edit</twig:Tabler:Dropdown:Item>
        </twig:Tabler:Dropdown:Menu>

    Props:
      items       — optional array of entries, rendered with Dropdown:Item (with a Badge after the label when
                    `badge` is set), Dropdown:Divider and Dropdown:Header; mirrored by the `content` block
      end         — align the menu to the end (dropdown-menu-end)
      arrow       — small arrow pointing at the toggle (dropdown-menu-arrow)
      dark        — dark menu on a light page (dropdown-menu-dark)
      scrollable  — caps the height and scrolls (dropdown-menu-scrollable)
      card        — card-like panel for rich content (dropdown-menu-card)

    Long menus can be split with <twig:Tabler:Dropdown:Columns> / <twig:Tabler:Dropdown:Column>.
#}
{% apply trim %}
{% props
    ## list<array{label?:string,href?:string,icon?:string,active?:bool,disabled?:bool,badge?:string|int,divider?:bool,header?:string}>|null The entries: links (`Dropdown:Item`), `{divider: true}` separators and `{header: '…'}` labels.
    items = null,
    ## bool Whether to align the menu to the end (`dropdown-menu-end`).
    end = false,
    ## bool Whether to add an arrow pointing at the toggle (`dropdown-menu-arrow`).
    arrow = false,
    ## bool Whether to render a dark menu (`dropdown-menu-dark`).
    dark = false,
    ## bool Whether to cap the height and scroll (`dropdown-menu-scrollable`).
    scrollable = false,
    ## bool Whether to render a panel for rich content (`dropdown-menu-card`).
    card = false,
%}

{% set menu = html_cva(
    base: 'dropdown-menu',
    variants: {
        end: {true: 'dropdown-menu-end', false: ''},
        arrow: {true: 'dropdown-menu-arrow', false: ''},
        dark: {true: 'dropdown-menu-dark', false: ''},
        scrollable: {true: 'dropdown-menu-scrollable', false: ''},
        card: {true: 'dropdown-menu-card', false: ''},
    },
) %}

<div class="{{ menu.apply({end: end, arrow: arrow, dark: dark, scrollable: scrollable, card: card}, attributes.render('class')) }}" {{ attributes.without('class') }}>
    {## The menu entries: a `Dropdown:Item`, `Dropdown:Divider` or `Dropdown:Header` for each entry of `items`. -#}
    {% block content %}
        {%- for entry in items ?? [] -%}
            {%- if entry.divider ?? false -%}
                <twig:Tabler:Dropdown:Divider />
            {%- elseif entry.header is defined -%}
                <twig:Tabler:Dropdown:Header>{{ entry.header }}</twig:Tabler:Dropdown:Header>
            {%- else -%}
                <twig:Tabler:Dropdown:Item
                    href="{{ entry.href ?? null }}"
                    icon="{{ entry.icon ?? null }}"
                    active="{{ entry.active ?? false }}"
                    disabled="{{ entry.disabled ?? false }}"
                >
                    {{- entry.label ?? '' -}}
                    {%- if (entry.badge ?? null) is not null %} <twig:Tabler:Badge class="ms-auto">{{ entry.badge }}</twig:Tabler:Badge>{% endif -%}
                </twig:Tabler:Dropdown:Item>
            {%- endif -%}
        {%- endfor -%}
    {% endblock %}
</div>
{% endapply ~%}
