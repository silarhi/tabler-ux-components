{#
    Dropdown toggle — the button that opens the menu. Renders a
    <button type="button">, so it never submits an enclosing <form>.

    Usage:
        <twig:Tabler:Dropdown:Toggle variant="primary">Menu</twig:Tabler:Dropdown:Toggle>

    Props:
      variant     — button color (primary, secondary, …); omit for a plain `.btn`
      noCaret     — hide the dropdown caret
      split    — caret-only half of a split button, next to a <twig:Tabler:Button> in a .btn-group
                 (dropdown-toggle-split); give it an `aria-label`
#}
{% apply trim %}
{% props
    variant = null,
    noCaret = false,
    split = false,
%}

{% set toggle = html_cva(
    base: 'btn',
    variants: {
        variant: {
            primary: 'btn-primary',
            secondary: 'btn-secondary',
            success: 'btn-success',
            danger: 'btn-danger',
            warning: 'btn-warning',
            info: 'btn-info',
            dark: 'btn-dark',
            light: 'btn-light',
        },
        noCaret: {true: '', false: 'dropdown-toggle'},
        split: {true: 'dropdown-toggle-split', false: ''},
    },
) %}

<button type="{{ attributes.render('type') ?? 'button' }}" class="{{ toggle.apply({variant: variant ?? '', noCaret: noCaret, split: split}, attributes.render('class')) }}" data-bs-toggle="dropdown" aria-expanded="false" {{ attributes.without('class', 'type') }}>{%- block content %}{% endblock -%}</button>
{% endapply ~%}
