{#
    Page header pretitle — the small overline above the title.

    Usage:
        <twig:Tabler:PageHeader:Pretitle>Overview</twig:Tabler:PageHeader:Pretitle>
#}
{% apply trim %}
<div {{ attributes.defaults({class: 'page-pretitle'}) }}>{## The pretitle. #}{%- block content %}{% endblock -%}</div>
{% endapply ~%}
