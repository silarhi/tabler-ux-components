{#
    Tabler PageHeader — a page title block with optional pretitle and actions.

    All-in-one:
        <twig:Tabler:PageHeader pretitle="Overview" title="Dashboard" />

    With actions (fill the `actions` block, so the title props are kept):
        <twig:Tabler:PageHeader pretitle="Overview" title="Dashboard">
            <twig:block name="actions">
                <twig:Tabler:PageHeader:Actions>
                    <twig:Tabler:Button variant="primary">New</twig:Tabler:Button>
                </twig:Tabler:PageHeader:Actions>
            </twig:block>
        </twig:Tabler:PageHeader>

    Direct children fill the `content` block, which wraps the whole header: they
    replace the row, so the `pretitle` and `title` props are no longer rendered.

    Props:
      pretitle  — small overline above the title; mirrored by the `pretitle` block
      title     — page title; mirrored by the `title` block
#}
{% apply trim %}
{% props
    ## string|null The small overline above the title, rendered with `PageHeader:Pretitle`.
    pretitle = null,
    ## string|null The page title, rendered with `PageHeader:Title`.
    title = null,
%}

<div {{ attributes.defaults({class: 'page-header d-print-none'}) }}>
    {## The whole header row; replacing it drops the `pretitle` and `title` props. -#}
    {% block content %}
        <div class="row align-items-center">
            <div class="col">
                {## The pretitle: `PageHeader:Pretitle` with the `pretitle` prop, when set. -#}
                {% block pretitle %}
                    {%- if pretitle is not null -%}<twig:Tabler:PageHeader:Pretitle>{{ pretitle }}</twig:Tabler:PageHeader:Pretitle>{%- endif -%}
                {% endblock %}
                {## The title: `PageHeader:Title` with the `title` prop, when set. -#}
                {% block title %}
                    {%- if title is not null -%}<twig:Tabler:PageHeader:Title>{{ title }}</twig:Tabler:PageHeader:Title>{%- endif -%}
                {% endblock %}
            </div>
            {## The right-aligned actions, e.g. a `PageHeader:Actions`; empty by default. -#}
            {% block actions %}{% endblock %}
        </div>
    {% endblock %}
</div>
{% endapply ~%}
