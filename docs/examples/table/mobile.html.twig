<twig:Tabler:Table mobile="md">
    <thead>
        <tr><th>Invoice</th><th>Customer</th><th>Status</th><th class="text-end">Amount</th></tr>
    </thead>
    <tbody>
        <tr>
            <td data-label="Invoice">INV-0142</td>
            <td data-label="Customer">Acme Corp</td>
            <td data-label="Status"><twig:Tabler:Badge variant="success" light="{{ true }}">Paid</twig:Tabler:Badge></td>
            <td data-label="Amount" class="text-end">€1,250.00</td>
        </tr>
        <tr>
            <td data-label="Invoice">INV-0143</td>
            <td data-label="Customer">Globex</td>
            <td data-label="Status"><twig:Tabler:Badge variant="warning" light="{{ true }}">Pending</twig:Tabler:Badge></td>
            <td data-label="Amount" class="text-end">€480.00</td>
        </tr>
    </tbody>
</twig:Tabler:Table>
